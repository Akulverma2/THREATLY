# Database (Neon / Vercel Postgres)
# DATABASE_URL: Neon pooled connection (used by Prisma at runtime via connection pooling)
# DIRECT_URL:   Neon direct connection (used by Prisma during migrations only)
DATABASE_URL="postgresql://user:password@host:5432/threatly?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/threatly?sslmode=require"

# NextAuth v5 (next-auth@5)
# AUTH_SECRET is the primary variable read by next-auth v5 in production.
# In production this MUST be set or NextAuth will throw MissingSecretError.
# Generate a value with: openssl rand -base64 32
# NEXTAUTH_SECRET is accepted as a fallback alias but AUTH_SECRET is preferred.
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# NEXTAUTH_URL / AUTH_URL
# Not strictly required in next-auth v5 (auto-inferred from request Host header),
# but recommended for production to avoid redirect mismatches.
# Set to the canonical HTTPS URL of the deployment, e.g.:
# NEXTAUTH_URL="https://yourdomain.com"

# Threat Intel APIs (optional — scanners degrade gracefully without these)
GOOGLE_SAFE_BROWSING_API_KEY=""
VIRUSTOTAL_API_KEY=""
URLHAUS_API_KEY=""
PHISHTANK_API_KEY=""

# Rate limiting — in-memory by default.
# For multi-instance / serverless deployments, provide an Upstash Redis endpoint
# to enable distributed rate limiting (requires code changes — see src/middleware/rate-limit.ts).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional rate limit tuning (defaults apply if unset)
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_REGISTER_WINDOW_MS=900000
# RATE_LIMIT_SCAN_MAX=30
# RATE_LIMIT_SCAN_WINDOW_MS=60000
